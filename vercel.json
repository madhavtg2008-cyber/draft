{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["public/**", "lib/**", "node_modules/@fontsource/**", "node_modules/@libsql/**", "node_modules/libsql/**"], "maxDuration": 60 }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/server.js" }]
}
